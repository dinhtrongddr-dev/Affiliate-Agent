# ChatGPT2API local OpenAI-compatible endpoint (not 9Router).
AA_AI_PROTOCOL=openai
AA_AI_BASE_URL=http://127.0.0.1:13000/v1
AA_AI_API_KEY=
AA_AI_MODEL=gpt-6-astra-wm
# ChatGPT2API Web conduit accepts extended for deep reasoning; high is normalized to off.
AA_AI_THINKING_EFFORT=extended

# Media is stored on E: to avoid filling the Windows system drive.
AA_MEDIA_ROOT=E:\AffiliateAgentMedia

# Shopee Vietnam Affiliate Open API
AA_SHOPEE_SKILL_HOME=D:\AffiliateAgent\config\shopee-skill
AA_SHOPEE_AFFILIATE_ENABLED=false

# Meta Facebook Page Reels. Fill these locally after creating/authorizing a Meta app.
AA_META_GRAPH_VERSION=
AA_META_PAGE_ID=
AA_META_PAGE_ACCESS_TOKEN=
AA_META_ENABLED=false

# Safety switches remain OFF until both publishers pass test posts.
AA_AUTO_PUBLISH=false
