# Copy to D:\AffiliateAgent\.env (or edit everything from the web UI -> Cài đặt).

# ---- AI gateway (OpenAI-compatible; ChatGPT2API local by default)
AA_AI_PROTOCOL=openai
AA_AI_BASE_URL=http://127.0.0.1:13000/v1
AA_AI_API_KEY=
AA_AI_MODEL=gpt-6-astra-wm
AA_AI_THINKING_EFFORT=extended

# ---- Storage
AA_MEDIA_ROOT=E:\AffiliateAgentMedia
# AA_MUSIC_DIR defaults to <media>\assets\music  (put licensed tracks here: upbeat_*.mp3, chill_*.mp3 ...)

# ---- Shopee Vietnam Affiliate Open API (App ID/Secret go in config\shopee-skill\credentials.json)
AA_SHOPEE_SKILL_HOME=D:\AffiliateAgent\config\shopee-skill
AA_SHOPEE_AFFILIATE_ENABLED=false
AA_SHOPEE_SEED_KEYWORDS=máy xay mini,đèn ngủ,ốp lưng,bình giữ nhiệt,son môi

# ---- Video creation
AA_AUTO_PROCESS=true
AA_TTS_ENABLED=true
AA_TTS_VOICE=vi-VN-HoaiMyNeural
AA_TTS_RATE=+8%
AA_MUSIC_VOLUME=0.22
AA_KEEP_SOURCE_AUDIO=false
AA_VIRAL_REVIEW=true
AA_VIRAL_MIN_SCORE=7
AA_CTA_TEXT=Link sản phẩm ở giỏ hàng / bình luận

# ---- Optional visual sources
AA_PEXELS_API_KEY=
# AI video generator (e.g. Muse): provider=http, see agent_core/assets.py VideoGenerator
# Trend Intelligence (optional keys; Google Trends + Google News VN work without keys)
AA_YOUTUBE_API_KEY=
AA_YOUTUBE_DAILY_UNITS=3000
AA_TRENDSMCP_API_KEY=
AA_TRENDSMCP_MONTHLY_BUDGET=90
AA_TREND_MIN_PURCHASE_INTENT=30
AA_TREND_WEIGHTS=

AA_VIDEOGEN_PROVIDER=none
AA_VIDEOGEN_BASE_URL=
AA_VIDEOGEN_API_KEY=
AA_VIDEOGEN_MODEL=

# ---- Meta Facebook Page Reels
AA_META_GRAPH_VERSION=
AA_META_PAGE_ID=
AA_META_PAGE_ACCESS_TOKEN=
AA_META_ENABLED=false

# ---- TikTok Content Posting API (inbox = send to TikTok drafts)
AA_TIKTOK_ENABLED=false
AA_TIKTOK_MODE=inbox
AA_TIKTOK_PRIVACY_LEVEL=SELF_ONLY
AA_TIKTOK_ACCESS_TOKEN=

# ---- Safety: public posting (Facebook, Shopee "publish", TikTok direct) stays OFF until tested
AA_AUTO_PUBLISH=false

# ---- Web UI
AA_WEB_HOST=127.0.0.1
AA_WEB_PORT=8765
